# Aegis local configuration — copy to .env and fill in.
# NEVER commit .env or put passwords here.

AEGIS_LAMMPS_BIN=lmp
# Parallel MD needs MPI-capable lmp (official *-MSMPI.exe on Windows) + mpiexec.
# AEGIS_MPIEXEC=C:\Program Files\Microsoft MPI\Bin\mpiexec.exe
# AEGIS_MPI_PROCS=1
# Set 0 to skip MS-MPI / OpenMPI install in setup_and_run:
# AEGIS_INSTALL_MPI=0
# Keep a serial/GUI LAMMPS and skip MSMPI upgrade during bootstrap:
# AEGIS_LAMMPS_SERIAL_OK=1
# Override MPI LAMMPS installer URL (default: rpm.lammps.org …-MSMPI.exe):
# AEGIS_LAMMPS_MPI_URL=https://rpm.lammps.org/windows/LAMMPS-64bit-stable-MSMPI.exe
# Fallback / override any LAMMPS installer (GUI last-resort):
# AEGIS_LAMMPS_URL=https://download.lammps.org/static/LAMMPS-Win10-x64-GUI-latest.exe
# Optional: OVITO Pro ovitos for DXA (pip install -U ovito is usually enough)
# AEGIS_OVITO_BIN=C:\Program Files\OVITO Pro\ovitos.exe
#
# Bootstrap tries pip install ovito on first run (soft-fail). Set 0 to skip:
# AEGIS_INSTALL_OVITO=0
#
# ASE (nanostructure builder) — also in apps/api/requirements.txt; soft-fail opt-out:
# AEGIS_INSTALL_ASE=0
# Optional Atomsk binary for higher-fidelity polycrystal / GB (ASE Voronoi fallback):
# AEGIS_ATOMSK_BIN=C:\path\to\atomsk.exe
# AEGIS_INSTALL_ATOMSK=0
AEGIS_DATA_ROOT=
AEGIS_RUNS_ROOT=
AEGIS_KART_ROOT=
AEGIS_KART_BIN=
AEGIS_KART_COMMIT=62d66adf

# Optional: MMonCa object-KMC (Phase-3 comparison; not required)
# AEGIS_MMONCA_BIN=
# AEGIS_MMONCA_ROOT=

# Optional: GitLab PAT for cloning KART (read_repository scope). Prefer SSH.
# GITLAB_TOKEN=